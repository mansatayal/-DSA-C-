#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:

    int first(vector<int>& nums ,int low, int high, int target){
        // check left
        int best = 0;

        while(high >= low){
            int mid = low + ((high - low) / 2);

            if(nums[mid] == target){
                best = mid;
                high = mid - 1;
            }
            else low = mid + 1;
            // value greater than target is not possible as we're looking in the left of the list
        }
        return best;
    }

    int last(vector<int>& nums, int low, int high, int target){
        // check right;
        int best = 0;

        while(high >= low){
            int mid = low + ((high - low) / 2);

            if(nums[mid] == target){
                best = mid;
                low = mid + 1;
            }
            else high = mid - 1;
            // value smaller than target is not possible as we're looking in the right of the list
        }
        return best;
    }

    vector<int> searchRange(vector<int>& nums, int target) {
        if(nums.empty() || nums[0] > target) return {-1,-1};

        vector<int> ans = {-1,-1};
        
        int low = 0;
        int high = nums.size() - 1;

        while(high >= low){
            int mid = low + ((high - low)/ 2);

            if(nums[mid] == target){
                ans[0] = first(nums, low, high, target);
                ans[1] = last(nums, low, high, target);
                break;
            }
            else (nums[mid] > target)? high = mid - 1 : low = mid + 1;
        }   

        return ans;


    }
};

